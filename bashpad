#!/usr/bin/env bash
#
#
#
#

fatal() {
    echo '[fatal]' "$@" >&2
    exit 1
}

source "./lib/cli.sh" || fatal "could not load CLI library"
source "./lib/config.sh" || fatal "could not load config library"
source "./lib/tui.sh" || fatal "could not load TUI library"

check_dependencies() {
    if ! command -v gum >/dev/null 2>&1; then
        printf 'Error: gum is not installed.\n' >&2
        printf 'Install it from: https://github.com/charmbracelet/gum\n' >&2
        exit 1
    fi
}

run_cli() {
    note "$@"
}

run_tui() {
    check_dependencies
    bash lib/tui.sh "$@"
}

main() {
    if [ ! -f "$config_file" ]; then
        create_default_config
    else
        load_config
    fi

    if [ ! -d "$notes_dir" ]; then
        mkdir -p "$notes_dir" || fatal "could not create notes directory: $notes_dir"
        find "$notes_dir" -type f -name "*.$file_extension"
    fi

    case "$mode" in
    CLI) run_cli "$@" ;;
    TUI) run_tui "$@" ;;
    *) fatal "unsupported mode: $mode" ;;
    esac
}

main "$@"
